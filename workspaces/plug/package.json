{
  "name": "@plugjs/plug",
  "version": "0.7.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "plug": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./asserts": {
      "types": "./dist/asserts.d.ts",
      "default": "./dist/asserts.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "default": "./dist/files.js"
    },
    "./fork": {
      "types": "./dist/fork.d.ts",
      "default": "./dist/fork.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "default": "./dist/fs.js"
    },
    "./globals": {
      "types": "./dist/globals.d.ts",
      "default": "./dist/globals.js"
    },
    "./logging": {
      "types": "./dist/logging.d.ts",
      "default": "./dist/logging.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./pipe": {
      "types": "./dist/pipe.d.ts",
      "default": "./dist/pipe.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    }
  },
  "author": "Juit Developers <developers@juit.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@plugjs/tsrun": "^0.7.2",
    "@types/node": "<23",
    "esbuild": "^0.28.1",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  },
  "files": [
    "*.md",
    "dist/",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plugjs/plug.git"
  },
  "keywords": [
    "build",
    "compile",
    "ecmascript",
    "javascript",
    "node",
    "plugjs",
    "transpile",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/plugjs/plug/issues"
  },
  "homepage": "https://github.com/plugjs/plug/blob/main/workspaces/plug/#readme"
}
