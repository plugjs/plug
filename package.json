{
  "name": "@plugjs/monorepo",
  "private": true,
  "version": "0.7.4",
  "type": "module",
  "workspaces": [
    "workspaces/cov8",
    "workspaces/eslint",
    "workspaces/expect5",
    "workspaces/plug",
    "workspaces/tsd",
    "workspaces/typescript",
    "workspaces/zip"
  ],
  "scripts": {
    "clean": "tsrun ./workspaces/plug/src/cli.ts clean",
    "dev": "npm run clean ; ls -1d workspaces/*/src workspaces/*/test | sed 's|^|-w |g' | xargs tsrun ./workspaces/plug/src/cli.ts dev -w test-d",
    "build": "tsrun ./workspaces/plug/src/cli.ts",
    "lint": "tsrun ./workspaces/plug/src/cli.ts lint",
    "test": "tsrun ./workspaces/plug/src/cli.ts transpile test",
    "transpile": "tsrun ./workspaces/plug/src/cli.ts transpile",
    "updates": "check-updates package.json workspaces/*/package.json"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@plugjs/eslint-plugin": "^0.7.5",
    "@plugjs/tsrun": "^0.7.7",
    "@types/node": "<23",
    "typescript": "<7"
  },
  "files": []
}
